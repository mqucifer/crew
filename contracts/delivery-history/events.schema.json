{
  "$defs": {
    "Attempt": {
      "additionalProperties": false,
      "description": "An attempt that didn't land, and what the crew decided to do about it.\n\n`reason` is present only when one of the crew's own checks wrote it with\nnothing but names filled in (ADR 0020); otherwise the failure class stands\nalone.\n\nEscalation's policy decides these, so they end with escalation (ADR 0032, Stage\nE): earlier sprints keep theirs, and later ones have none. A story delivered in\nDeveloper sessions misses on review's and QA's returns instead (`verdict` on\n`work_finished`), and its deliveries are in the analysis.",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "card": {
          "$ref": "#/$defs/CardRef"
        },
        "decision": {
          "anyOf": [
            {
              "enum": [
                "retry_local",
                "return_to_refinement",
                "file_prompt_defect",
                "escalate",
                "block"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decision"
        },
        "failure_class": {
          "title": "Failure Class",
          "type": "string"
        },
        "kind": {
          "const": "attempt",
          "default": "attempt",
          "title": "Kind",
          "type": "string"
        },
        "number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which local attempt this was, from 1.",
          "title": "Number"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Role"
        }
      },
      "required": [
        "kind",
        "at",
        "card",
        "role",
        "number",
        "failure_class",
        "decision",
        "reason"
      ],
      "title": "Attempt",
      "type": "object"
    },
