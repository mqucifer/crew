      ],
      "title": "Escalated",
      "type": "object"
    },
    "GateChecked": {
      "additionalProperties": false,
      "description": "The crew's gate on a session's branch at `done`, before review (ADR 0032).\n\nA gate's return is the Developer still working, not an attempt (the Sponsor,\n2026-10-18, crew#778): its findings are named by their rules, never their text.",
      "properties": {
        "already_done": {
          "description": "The branch had nothing to change: the story goes to QA with an empty diff.",
          "title": "Already Done",
          "type": "boolean"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "card": {
          "$ref": "#/$defs/CardRef"
