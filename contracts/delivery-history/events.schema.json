          "const": "gate_checked",
          "default": "gate_checked",
          "title": "Kind",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "rules": {
          "description": "The declared rules its findings were by (ADR 0031).",
          "items": {
            "type": "string"
          },
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "at",
        "card",
        "passed",
        "rules",
        "already_done"
      ],
      "title": "GateChecked",
      "type": "object"
    },
