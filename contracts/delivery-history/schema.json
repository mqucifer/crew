                      "null"
                    ]
                  },
                  "points_delivered": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "superseded_breakdown": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "superseded_count": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "superseded_points": {
