{
  "$defs": {
    "Attempt": {
      "additionalProperties": false,
      "description": "An attempt that didn't land, and what the crew decided to do about it.\n\n`reason` is present only when one of the crew's own checks wrote it with\nnothing but names filled in (ADR 0020); otherwise the failure class stands\nalone.",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "card": {
          "$ref": "#/$defs/CardRef"
        },
        "decision": {
          "anyOf": [
            {
              "enum": [
                "retry_local",
                "return_to_refinement",
                "file_prompt_defect",
                "escalate",
                "block"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decision"
        },
        "failure_class": {
          "title": "Failure Class",
          "type": "string"
        },
        "kind": {
          "const": "attempt",
          "default": "attempt",
          "title": "Kind",
          "type": "string"
        },
        "number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which local attempt this was, from 1.",
          "title": "Number"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Role"
        }
      },
      "required": [
        "kind",
        "at",
        "card",
        "role",
        "number",
        "failure_class",
        "decision",
        "reason"
      ],
      "title": "Attempt",
      "type": "object"
    },
    "Blocked": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "card": {
          "$ref": "#/$defs/CardRef"
        },
        "kind": {
          "const": "blocked",
          "default": "blocked",
          "title": "Kind",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Role"
        }
      },
      "required": [
        "kind",
        "at",
        "card",
        "role"
      ],
      "title": "Blocked",
      "type": "object"
    },
    "Card": {
      "additionalProperties": false,
      "description": "A card on the board. Its title is already public on GitHub.",
      "properties": {
        "closed": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Closed"
        },
        "created": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Created"
        },
        "number": {
          "title": "Number",
          "type": "integer"
        },
        "parent": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The parent card's number, in the same repository.",
          "title": "Parent"
        },
        "points": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Points"
        },
        "repo": {
          "title": "Repo",
          "type": "string"
        },
        "sprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sprint"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "enum": [
                "Goal",
                "Epic",
                "Story"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Type"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        }
      },
      "required": [
        "repo",
        "number",
        "type",
        "title",
        "url",
        "parent",
        "points",
        "sprint",
        "status",
        "created",
        "closed"
      ],
      "title": "Card",
      "type": "object"
    },
    "CardMoved": {
      "additionalProperties": false,
      "description": "A card moving between columns.\n\n`by` says who: the crew (and `role`, the role that moved it), a person, or\nthe platform (the board's own workflow). The Sponsor's approvals are a\nperson moving a Goal or an Epic.",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "by": {
          "enum": [
            "crew",
            "person",
            "platform"
          ],
          "title": "By",
          "type": "string"
        },
        "card": {
          "$ref": "#/$defs/CardRef"
        },
        "from_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "From Column"
        },
        "kind": {
          "const": "card_moved",
          "default": "card_moved",
          "title": "Kind",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Role"
        },
        "to_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "To Column"
        }
      },
      "required": [
        "kind",
        "at",
        "card",
        "from_column",
        "to_column",
        "by",
        "role"
      ],
      "title": "CardMoved",
      "type": "object"
    },
    "CardRef": {
      "additionalProperties": false,
      "description": "A card, by repository and number: numbers repeat across repositories.",
      "properties": {
        "number": {
          "title": "Number",
          "type": "integer"
        },
        "repo": {
          "title": "Repo",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "number"
      ],
      "title": "CardRef",
      "type": "object"
    },
    "Escalated": {
      "additionalProperties": false,
