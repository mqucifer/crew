    "WorkStarted": {
      "additionalProperties": false,
      "description": "A role starting work on a card, or on no card (planning, the retro).\n\nA review is work on a pull request: `pull` names it, and `card` the card it\ncloses, when it closes exactly one.",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "card": {
          "anyOf": [
            {
              "$ref": "#/$defs/CardRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "const": "work_started",
          "default": "work_started",
          "title": "Kind",
          "type": "string"
        },
        "pull": {
          "anyOf": [
            {
              "$ref": "#/$defs/PullRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "at",
        "card",
        "pull",
        "role"
      ],
      "title": "WorkStarted",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Everything up to the package's date, so a consumer needs only the latest.",
  "properties": {
    "cards": {
      "items": {
        "$ref": "#/$defs/Card"
      },
      "title": "Cards",
      "type": "array"
    },
    "crew_repository": {
      "title": "Crew Repository",
      "type": "string"
    },
    "date": {
      "format": "date",
      "title": "Date",
      "type": "string"
    },
    "events": {
      "description": "Oldest first.",
      "items": {
        "discriminator": {
          "mapping": {
            "attempt": "#/$defs/Attempt",
            "blocked": "#/$defs/Blocked",
            "card_moved": "#/$defs/CardMoved",
            "escalated": "#/$defs/Escalated",
            "model_call": "#/$defs/ModelCall",
            "pull_merged": "#/$defs/PullMerged",
            "work_finished": "#/$defs/WorkFinished",
            "work_started": "#/$defs/WorkStarted"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/CardMoved"
          },
          {
            "$ref": "#/$defs/WorkStarted"
          },
          {
            "$ref": "#/$defs/WorkFinished"
          },
          {
            "$ref": "#/$defs/Attempt"
          },
          {
            "$ref": "#/$defs/Blocked"
          },
          {
            "$ref": "#/$defs/Escalated"
          },
          {
            "$ref": "#/$defs/ModelCall"
          },
          {
            "$ref": "#/$defs/PullMerged"
          }
        ]
      },
      "title": "Events",
      "type": "array"
    },
    "package": {
      "const": "delivery-history",
      "default": "delivery-history",
      "title": "Package",
      "type": "string"
    },
    "repositories": {
      "description": "The delivery repositories it covers.",
      "items": {
        "type": "string"
      },
      "title": "Repositories",
      "type": "array"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "sprints": {
      "items": {
        "$ref": "#/$defs/Sprint"
      },
      "title": "Sprints",
      "type": "array"
    },
    "timezone": {
      "description": "The timezone sprint days are counted in.",
      "title": "Timezone",
      "type": "string"
    }
  },
  "required": [
    "package",
    "schema_version",
    "date",
    "timezone",
    "crew_repository",
    "repositories",
    "sprints",
    "cards",
    "events"
  ],
  "title": "DeliveryHistory",
  "type": "object"
}
