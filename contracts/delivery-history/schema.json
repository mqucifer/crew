          "type": "string"
        },
        "card": {
          "$ref": "#/$defs/CardRef"
        },
        "kind": {
          "const": "escalated",
          "default": "escalated",
          "title": "Kind",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Role"
        }
      },
      "required": [
        "kind",
        "at",
        "card",
        "role"
      ],
      "title": "Escalated",
      "type": "object"
    },
    "ModelCall": {
      "additionalProperties": false,
      "description": "One call to a model: what it cost in tokens and time. No money is recorded.",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "card": {
          "anyOf": [
            {
              "$ref": "#/$defs/CardRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "completion_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Completion Tokens"
        },
        "failed": {
          "title": "Failed",
          "type": "boolean"
        },
        "kind": {
          "const": "model_call",
          "default": "model_call",
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The model alias the crew asked for.",
          "title": "Model"
        },
        "prompt_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Prompt Tokens"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reasoning Tokens"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Role"
        },
        "seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Seconds"
        },
        "step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the call was for, such as deliver or refine.",
          "title": "Step"
        }
