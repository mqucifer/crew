{
  "$defs": {
    "Analysis": {
      "additionalProperties": false,
      "properties": {
        "deliveries": {
          "description": "Every delivery in Developer sessions, by story, oldest first.",
          "items": {
            "$ref": "#/$defs/Delivery"
          },
          "title": "Deliveries",
          "type": "array"
        },
        "sprints": {
          "description": "Every sprint started by the package's date.",
          "items": {
            "$ref": "#/$defs/SprintAnalysis"
          },
          "title": "Sprints",
          "type": "array"
        },
        "stories": {
          "description": "Every story and bug with events.",
          "items": {
            "$ref": "#/$defs/StoryPattern"
          },
          "title": "Stories",
          "type": "array"
        }
      },
      "required": [
        "sprints",
        "stories",
        "deliveries"
      ],
      "title": "Analysis",
      "type": "object"
    },
    "Attention": {
      "additionalProperties": false,
      "description": "Something that needed a person, or kept going wrong, as the sprint stood at its end.",
      "properties": {
        "card": {
          "$ref": "#/$defs/CardRef"
        },
        "count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "For a repeated refusal, how many times it came.",
          "title": "Count"
        },
        "kind": {
          "enum": [
            "waiting_on_sponsor",
            "blocked",
            "repeated_refusal"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "For a repeated refusal, the reason that repeated.",
          "title": "Reason"
        },
        "since": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "When it started waiting, or was blocked.",
          "title": "Since"
        },
        "text": {
          "description": "The sentence the crew's code wrote from these values.",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "card",
        "since",
        "count",
        "reason",
        "text"
      ],
      "title": "Attention",
      "type": "object"
    },
    "Card": {
      "additionalProperties": false,
      "description": "A card on the board. Its title is already public on GitHub.",
      "properties": {
        "closed": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Closed"
        },
        "closed_as": {
          "anyOf": [
            {
              "enum": [
                "completed",
                "not_planned",
                "duplicate"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "How the issue closed. A story closed as not planned was superseded: never built, though the board shows it Done.",
          "title": "Closed As"
        },
        "created": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Created"
        },
        "number": {
          "title": "Number",
          "type": "integer"
        },
        "parent": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The parent card's number, in the same repository.",
          "title": "Parent"
        },
        "points": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Points"
        },
        "repo": {
          "title": "Repo",
          "type": "string"
        },
        "sprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sprint"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status"
        },
        "status_set": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "When its status was last set, by anyone.",
          "title": "Status Set"
        },
        "superseded_because": {
          "anyOf": [
            {
              "enum": [
                "sponsor",
                "story_problem"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why a story closed as not planned was superseded: its epic was split again at the Sponsor's request, or after a story problem. None when no re-split recorded it.",
          "title": "Superseded Because"
        },
        "technical": {
          "description": "Technical work the crew found itself, from a design or a failing main. It skips the Sponsor's gate (crew#192, crew#335).",
          "title": "Technical",
          "type": "boolean"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "enum": [
                "Goal",
                "Epic",
                "Story",
                "Bug"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Type"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        }
      },
      "required": [
        "repo",
        "number",
        "type",
        "title",
        "url",
        "parent",
        "points",
        "sprint",
        "status",
        "status_set",
        "created",
        "closed",
        "technical",
        "closed_as",
        "superseded_because"
      ],
      "title": "Card",
      "type": "object"
    },
    "CardRef": {
      "additionalProperties": false,
      "description": "A card, by repository and number: numbers repeat across repositories.",
      "properties": {
        "number": {
          "title": "Number",
          "type": "integer"
        },
        "repo": {
          "title": "Repo",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "number"
      ],
      "title": "CardRef",
      "type": "object"
    },
    "Change": {
      "additionalProperties": false,
      "description": "A measure that moved since the sprint before.\n\nsprint-metrics' measures are its own numbers, as it answered them: the crew\npicks which moves to say and words them, and never recomputes one.",
      "properties": {
        "better": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether it moved for the better; none if neither.",
          "title": "Better"
        },
        "measure": {
          "enum": [
            "first_attempt_rate_percent",
            "throughput",
            "points_delivered",
            "escalation_count",
            "blocked_aging_days",
            "wip_violations",
            "cycle_time_minutes",
            "lead_time_minutes",
            "superseded_count",
            "crew_fixes_merged"
          ],
          "title": "Measure",
          "type": "string"
        },
        "now": {
          "title": "Now",
          "type": "number"
        },
        "previous": {
          "title": "Previous",
          "type": "number"
        },
        "source": {
          "enum": [
            "sprint-metrics",
            "crew"
          ],
          "title": "Source",
          "type": "string"
        },
        "text": {
          "description": "The sentence the crew's code wrote from these values.",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "measure",
        "source",
        "previous",
        "now",
        "better",
        "text"
      ],
      "title": "Change",
      "type": "object"
    },
    "Decided": {
      "additionalProperties": false,
      "description": "Something the crew decided on its own in the sprint, without asking anyone.",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "kind": {
          "enum": [
            "design_revision_merged",
            "technical_epic_filed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "number": {
          "description": "The pull request merged, or the epic filed.",
          "title": "Number",
          "type": "integer"
        },
        "repo": {
          "title": "Repo",
          "type": "string"
        },
        "text": {
          "description": "The sentence the crew's code wrote from these values.",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "at",
        "repo",
        "number",
        "text"
      ],
      "title": "Decided",
      "type": "object"
    },
    "Delivery": {
      "additionalProperties": false,
      "description": "One delivery of a story in Developer sessions, from its first session to its outcome.\n\nDerived from the package's own events (crew#778, decision 8). An attempt is the\nbranch handed to review and QA (the Sponsor, 2026-10-18): `submissions` counts\nthem, and the gate's returns before review are `gate_rounds`, which don't spoil a\nfirst attempt. Outcomes: `done` (moved to Done), `returned` (to the Business\nAnalyst), `blocked` (left for a person: a choice, or nowhere to return it),\n`interrupted` (its last session was, and none followed), `open`.",
      "properties": {
        "blocked_on": {
          "anyOf": [
            {
              "enum": [
                "file",
                "fact",
                "choice",
                "stop"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Blocked On"
        },
        "cached_tokens": {
          "title": "Cached Tokens",
          "type": "integer"
        },
        "card": {
          "$ref": "#/$defs/CardRef"
        },
        "ceiling": {
          "anyOf": [
            {
              "enum": [
                "reading",
                "re_viewing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ceiling"
        },
        "completion_tokens": {
          "title": "Completion Tokens",
          "type": "integer"
        },
        "edits_since_run": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Edits Since Run"
        },
        "empty_lookups": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Empty Lookups"
        },
        "ended": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ended"
        },
        "first_green_run": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Of its runs, from 1, the first whole suite that passed.",
          "title": "First Green Run"
        },
        "gaps": {
          "description": "What its records lacked, built around: a session with no end (a crash, or still running), or an end with no start. Nothing is guessed.",
          "items": {
            "enum": [
              "session_not_ended",
              "session_not_started"
            ],
            "type": "string"
          },
          "title": "Gaps",
          "type": "array"
        },
        "gate_rounds": {
          "description": "Times the gate at `done` returned it before review.",
          "title": "Gate Rounds",
          "type": "integer"
        },
        "gate_rules": {
          "description": "The rules the gate's returns were by.",
          "items": {
            "type": "string"
          },
          "title": "Gate Rules",
          "type": "array"
        },
        "model_calls": {
          "title": "Model Calls",
          "type": "integer"
        },
        "model_seconds": {
          "title": "Model Seconds",
          "type": "number"
        },
        "most_views": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Most Views"
        },
        "number": {
          "description": "Which delivery of the story this is, from 1.",
          "title": "Number",
          "type": "integer"
        },
        "outcome": {
          "enum": [
            "done",
            "returned",
            "blocked",
            "interrupted",
            "open"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "prompt_tokens": {
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "reasoning_tokens": {
          "title": "Reasoning Tokens",
          "type": "integer"
        },
        "resumes": {
          "description": "Sessions started after an interrupted one (P3).",
          "title": "Resumes",
          "type": "integer"
        },
        "returned_because": {
          "anyOf": [
            {
              "enum": [
                "gate round trips",
                "pinned tests",
                "review conflicts with a criterion",
                "session blocked",
                "contract ruling"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Returned Because"
        },
        "review_returns": {
          "description": "Returns by review or QA.",
          "title": "Review Returns",
          "type": "integer"
        },
        "rework_rounds": {
          "description": "Sessions started after a return by the gate, review or QA (P2).",
          "title": "Rework Rounds",
          "type": "integer"
        },
        "runs": {
          "title": "Runs",
          "type": "integer"
        },
        "sessions": {
          "title": "Sessions",
          "type": "integer"
        },
        "since_action": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Its last session's signals at the end.",
          "title": "Since Action"
        },
        "started": {
          "format": "date-time",
          "title": "Started",
          "type": "string"
        },
        "stop": {
          "anyOf": [
            {
              "enum": [
                "no_progress",
                "backstop",
                "ceiling",
                "no_tool_call",
                "gate_repeat",
                "context_full"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "What stopped its last session, or the delivery between sessions (the backstop, or the gates' same findings again), if anything did.",
          "title": "Stop"
        },
        "submissions": {
          "description": "Times its branch was handed to review and QA: a move into Reviewing, or into QAing from anywhere else, as a story already done is.",
          "title": "Submissions",
          "type": "integer"
        }
      },
      "required": [
        "card",
        "number",
        "started",
        "ended",
        "outcome",
        "sessions",
        "submissions",
        "gate_rounds",
        "gate_rules",
        "review_returns",
        "rework_rounds",
        "resumes",
        "model_calls",
        "model_seconds",
        "prompt_tokens",
        "cached_tokens",
        "completion_tokens",
        "reasoning_tokens",
        "runs",
        "first_green_run",
        "stop",
        "blocked_on",
        "ceiling",
        "since_action",
        "most_views",
        "edits_since_run",
        "empty_lookups",
        "returned_because",
        "gaps"
      ],
      "title": "Delivery",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "description": "Days whose events share a file: a sprint, or a run of days between sprints.",
      "properties": {
        "end": {
          "description": "The period's last day, inclusive.",
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "events": {
          "title": "Events",
          "type": "integer"
        },
        "file": {
          "description": "Its events file, relative to the package's root.",
          "title": "File",
          "type": "string"
        },
        "sprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The sprint's name; none for days between sprints.",
          "title": "Sprint"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "sprint",
        "start",
        "end",
        "file",
        "events"
      ],
      "title": "Period",
      "type": "object"
    },
    "PullRef": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "title": "Number",
          "type": "integer"
        },
        "repo": {
          "title": "Repo",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "number"
      ],
      "title": "PullRef",
      "type": "object"
    },
    "Repeated": {
      "additionalProperties": false,
      "description": "The refusal a story got most often, when the crew's check wrote its reason.",
      "properties": {
        "count": {
          "title": "Count",
          "type": "integer"
        },
        "failure_class": {
          "title": "Failure Class",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "failure_class",
        "reason",
        "count"
      ],
      "title": "Repeated",
      "type": "object"
    },
    "Sprint": {
      "additionalProperties": false,
      "description": "A board iteration: its name and the days it runs, in the package's timezone.",
      "properties": {
        "end": {
          "description": "The sprint's last day, inclusive.",
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "name",
        "start",
        "end"
      ],
      "title": "Sprint",
      "type": "object"
    },
    "SprintAnalysis": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "description": "The moment it describes: the sprint's end, or the package's date for a sprint still running.",
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "attention": {
          "items": {
            "$ref": "#/$defs/Attention"
          },
          "title": "Attention",
          "type": "array"
        },
        "changed": {
          "items": {
            "$ref": "#/$defs/Change"
          },
          "title": "Changed",
          "type": "array"
        },
        "decided": {
          "items": {
            "$ref": "#/$defs/Decided"
          },
          "title": "Decided",
          "type": "array"
        },
        "sprint": {
          "title": "Sprint",
          "type": "string"
        }
      },
      "required": [
        "sprint",
        "as_of",
        "changed",
        "attention",
        "decided"
      ],
      "title": "SprintAnalysis",
      "type": "object"
    },
