{
  "$defs": {
    "Card": {
      "additionalProperties": false,
      "description": "A card on the board. Its title is already public on GitHub.",
      "properties": {
        "closed": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Closed"
        },
        "closed_as": {
          "anyOf": [
            {
              "enum": [
                "completed",
                "not_planned",
                "duplicate"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "How the issue closed. A story closed as not planned was superseded: never built, though the board shows it Done.",
          "title": "Closed As"
        },
        "created": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Created"
        },
        "filed": {
          "$ref": "#/$defs/Filed",
          "description": "How it came to be filed."
        },
        "number": {
          "title": "Number",
          "type": "integer"
        },
        "parent": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The parent card's number, in the same repository.",
          "title": "Parent"
        },
        "points": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Points"
        },
        "repo": {
          "title": "Repo",
          "type": "string"
        },
        "sprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sprint"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status"
        },
        "status_set": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "When its status was last set, by anyone.",
          "title": "Status Set"
        },
        "superseded_because": {
          "anyOf": [
            {
              "enum": [
                "sponsor",
                "story_problem"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why a story closed as not planned was superseded: its epic was split again at the Sponsor's request, or after a story problem. None when no re-split recorded it.",
          "title": "Superseded Because"
        },
        "technical": {
          "description": "Technical work the crew found itself, from a design or a failing main. It skips the Sponsor's gate (crew#192, crew#335).",
          "title": "Technical",
          "type": "boolean"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "enum": [
                "Goal",
                "Epic",
                "Story",
                "Bug"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Type"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        }
      },
      "required": [
        "repo",
        "number",
        "type",
        "title",
        "url",
        "parent",
        "points",
        "sprint",
        "status",
        "status_set",
        "created",
        "closed",
        "technical",
        "closed_as",
        "superseded_because",
        "filed"
      ],
      "title": "Card",
      "type": "object"
    },
    "Filed": {
      "additionalProperties": false,
      "description": "How a card came to be filed: the agent and the activity, as W3C PROV has it.\n\nWhat the crew wrote when it filed the card, and no judgement of it. Unknown is\nsaid, never guessed: cards older than a mark say what they can (crew#974).",
      "properties": {
        "activity": {
          "anyOf": [
            {
              "enum": [
                "finding",
                "task",
                "technical_epic",
                "split",
                "proposed_goal",
                "skeleton_goal",
                "record_change",
                "retro",
                "standup"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What opened it, for the crew's own: a role's finding, a role's Task, a technical epic, a split of filed work, a proposed or skeleton Goal, a change to a project's record, or a sprint's retro or standup. None for anyone else's, and for an older card of the crew's with nothing written to read it from.",
          "title": "Activity"
        },
        "by": {
          "default": "unknown",
          "description": "Who filed the issue, by its author on GitHub. `other` is anyone else. `unknown` is an issue with no author, or one under the Sponsor's login from before the operator had its own (crew#566), which can't be told apart.",
          "enum": [
            "crew",
            "sponsor",
            "operator",
            "other",
            "unknown"
          ],
          "title": "By",
          "type": "string"
        },
        "for_project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The project a card filed in another repository is for, by its `project:` label: QA's Tasks in qa-suite. Their `repo` is qa-suite.",
          "title": "For Project"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "alert",
                "announced",
                "ci-services",
                "deploy",
                "diagram",
                "dispute",
                "escaped-bug",
                "finding",
                "first-diagram",
                "first-workspace",
                "need",
                "release",
                "review",
                "story-test",
                "adoption",
                "design",
                "main-red",
                "release-check",
                "onboarding",
                "revisit"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A Task's kind, a technical epic's cause, or a record's change. A later MINOR may add kinds: accept one you don't know.",
          "title": "Kind"
        }
      },
      "required": [
        "by",
        "activity",
        "kind",
        "for_project"
      ],
      "title": "Filed",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "description": "Days whose events share a file: a sprint, or a run of days between sprints.",
      "properties": {
        "end": {
          "description": "The period's last day, inclusive.",
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "events": {
          "title": "Events",
          "type": "integer"
        },
        "file": {
          "description": "Its events file, relative to the package's root.",
          "title": "File",
          "type": "string"
        },
        "sprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The sprint's name; none for days between sprints.",
          "title": "Sprint"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "sprint",
        "start",
        "end",
        "file",
        "events"
      ],
      "title": "Period",
      "type": "object"
    },
    "Sprint": {
      "additionalProperties": false,
      "description": "A board iteration: its name and the days it runs, in the package's timezone.",
      "properties": {
        "end": {
          "description": "The sprint's last day, inclusive.",
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "name",
        "start",
        "end"
      ],
      "title": "Sprint",
      "type": "object"
    },
