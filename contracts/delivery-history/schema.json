      "required": [
        "kind",
        "at",
        "card",
        "role",
        "step",
        "model",
        "prompt_tokens",
        "completion_tokens",
        "reasoning_tokens",
        "seconds",
        "failed"
      ],
      "title": "ModelCall",
      "type": "object"
    },
    "PullMerged": {
      "additionalProperties": false,
      "description": "A pull request merging. In the crew's own repository, that's a fix to the crew.",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "closes": {
          "items": {
            "$ref": "#/$defs/CardRef"
          },
          "title": "Closes",
          "type": "array"
        },
        "crews_own": {
          "description": "Merged into the crew's own repository.",
          "title": "Crews Own",
          "type": "boolean"
        },
        "kind": {
          "const": "pull_merged",
          "default": "pull_merged",
          "title": "Kind",
          "type": "string"
        },
        "number": {
          "title": "Number",
          "type": "integer"
        },
        "repo": {
          "title": "Repo",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "at",
        "repo",
        "number",
        "title",
        "closes",
        "crews_own"
      ],
      "title": "PullMerged",
      "type": "object"
    },
    "PullRef": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "title": "Number",
          "type": "integer"
        },
        "repo": {
          "title": "Repo",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "number"
      ],
      "title": "PullRef",
      "type": "object"
    },
    "Sprint": {
      "additionalProperties": false,
      "description": "A board iteration: its name and the days it runs, in the package's timezone.",
      "properties": {
        "end": {
          "description": "The sprint's last day, inclusive.",
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "name",
        "start",
        "end"
      ],
      "title": "Sprint",
      "type": "object"
    },
    "WorkFinished": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "card": {
          "anyOf": [
            {
              "$ref": "#/$defs/CardRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "const": "work_finished",
          "default": "work_finished",
          "title": "Kind",
          "type": "string"
        },
