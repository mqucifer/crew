    "StoryPattern": {
      "additionalProperties": false,
      "description": "A story's path, as one pattern, the facts behind it, and a sentence.\n\nThe patterns, first that fits: `superseded` (closed as not planned),\n`first_try` (delivered with no miss and no block), `crew_fix` (delivered,\nand a fix to the crew merged between its first miss and its delivery, from\na crew issue that cites it), `escalated`, `retried` (delivered after\nmisses), `blocked` (in Blocked now), `open`. A fix whose issue doesn't cite\nthe story isn't counted, however close in time: nothing is guessed.",
      "properties": {
        "blocks": {
          "description": "Moves into Blocked.",
          "title": "Blocks",
          "type": "integer"
        },
        "card": {
          "$ref": "#/$defs/CardRef"
        },
        "cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/StoryCost"
            },
            {
              "type": "null"
            }
          ],
          "description": "None when none of its model calls could be placed: older calls don't name their repository, and are left out rather than guessed."
        },
        "crew_fixes": {
          "description": "Fixes to the crew, from issues that cite it, that merged between its first miss and its delivery.",
          "items": {
            "$ref": "#/$defs/PullRef"
          },
          "title": "Crew Fixes",
          "type": "array"
        },
        "delivered": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Delivered"
        },
        "escalations": {
          "description": "Times it was escalated: none in sprints after escalation retired (ADR 0032).",
          "title": "Escalations",
          "type": "integer"
        },
        "misses": {
          "description": "Attempts that didn't land. For a story delivered in sessions, its returns by review or QA, or to the Business Analyst; never the gate's before review.",
          "title": "Misses",
          "type": "integer"
        },
        "pattern": {
          "enum": [
            "first_try",
            "crew_fix",
            "escalated",
            "retried",
            "superseded",
            "blocked",
            "open"
          ],
          "title": "Pattern",
          "type": "string"
        },
        "repeated": {
          "anyOf": [
            {
              "$ref": "#/$defs/Repeated"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "description": "The sentence the crew's code wrote from these values.",
          "title": "Text",
          "type": "string"
        },
        "wall_clock_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "From the first work on it to its delivery; none until it's delivered.",
          "title": "Wall Clock Seconds"
        }
      },
      "required": [
        "card",
        "pattern",
        "misses",
        "blocks",
        "escalations",
        "crew_fixes",
        "repeated",
        "delivered",
        "wall_clock_seconds",
        "cost",
        "text"
      ],
      "title": "StoryPattern",
      "type": "object"
    }
